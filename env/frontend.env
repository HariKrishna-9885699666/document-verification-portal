# =============================================================================
# Frontend (Next.js) Environment
# =============================================================================
# Used by Next.js at build time and runtime for API connectivity.
# Next.js substitutes NEXT_PUBLIC_* variables at build time.
# =============================================================================

# Public API URL exposed to the browser (must be browser-accessible)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Server-side API URL for Next.js rewrites (uses Docker Compose service name)
API_URL=http://backend:4000/api

# Server port
PORT=3000
