# =============================================================================
# Frontend (Next.js) Environment
# =============================================================================
# Used by Next.js at build time and runtime for API connectivity.
# Next.js substitutes NEXT_PUBLIC_* variables at build time.
# =============================================================================

# Public API URL exposed to the browser
# This must be the browser-accessible address of the backend
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Server port
PORT=3000
