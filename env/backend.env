# =============================================================================
# Backend (NestJS) Environment
# =============================================================================
# Used by the NestJS API server for database connections, JWT signing,
# AWS client configuration, and server port binding.
# =============================================================================

# --- PostgreSQL Connection ---
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=dvp_user
DATABASE_PASSWORD=dvp_pass
DATABASE_NAME=dvp_db

# --- JWT Authentication ---
# Change this in production to a strong random secret
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRATION=24h

# --- Server ---
PORT=4000

# --- AWS / Floci Configuration ---
# Point AWS SDK clients at Floci instead of real AWS
AWS_ENDPOINT_URL=http://floci:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
