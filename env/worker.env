# =============================================================================
# OCR Worker (Python FastAPI) Environment
# =============================================================================
# Used by the Python OCR worker to know where the backend is and how
# to connect to AWS services (S3 for document download, via Floci).
# =============================================================================

# NestJS backend URL (used to POST OCR results back)
BACKEND_URL=http://backend:4000/api

# Port for the FastAPI server
WORKER_PORT=8000

# --- AWS / Floci Configuration ---
AWS_ENDPOINT_URL=http://floci:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
