# =============================================================================
# PostgreSQL Database Environment
# =============================================================================
# These credentials are used by:
#   1. The postgres container to initialize the database
#   2. The backend container to connect to the database
# =============================================================================

# Database name
POSTGRES_DB=dvp_db

# Database superuser name
POSTGRES_USER=dvp_user

# Database superuser password
POSTGRES_PASSWORD=dvp_pass
