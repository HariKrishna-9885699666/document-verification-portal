# =============================================================================
# Floci - AWS Local Emulator Environment
# =============================================================================
# All settings are documented at: https://fredpena-floci.mintlify.app/configuration/overview
# =============================================================================

# Hostname used in response URLs (important in multi-container Docker Compose)
FLOCI_HOSTNAME=floci

# Default AWS region used in ARNs and service responses
FLOCI_DEFAULT_REGION=us-east-1

# Default AWS account ID used in ARNs (any 12-digit string works locally)
FLOCI_DEFAULT_ACCOUNT_ID=000000000000

# Storage mode: memory | persistent | hybrid | wal
# 'persistent' preserves data across container restarts
FLOCI_STORAGE_MODE=persistent

# Dummy AWS credentials (Floci accepts any non-empty values)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
